# Production environment reference for ECS / Secrets Manager
# Values marked SECRET belong in AWS Secrets Manager (managed by Terraform).

# Application
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
APP_NAME=Enterprise AI Knowledge Assistant

# Auth (SECRET)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SECRET as full DATABASE_URL)
# postgresql://kaadmin:PASSWORD@RDS_ENDPOINT:5432/enterprise_ai_assistant
DATABASE_URL=

# Storage
STORAGE_BACKEND=s3
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# Prefer IAM task role over static keys in ECS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Vector store
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant.enterprise-ai-assistant-production.local:6333
QDRANT_COLLECTION=enterprise_documents
# Or Pinecone:
# VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX=

# Embeddings / LLM
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# CORS (set to ALB URL after deploy)
CORS_ORIGINS=http://YOUR_ALB_DNS

# Chunking / RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
