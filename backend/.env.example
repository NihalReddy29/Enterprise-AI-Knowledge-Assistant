# Application
APP_NAME=Enterprise AI Knowledge Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_assistant

# JWT Authentication
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Storage (Phase 2)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OCR (Phase 2)
TESSERACT_CMD=
OCR_LANGUAGE=eng
MIN_TEXT_CHARS_FOR_OCR=50
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,png,jpg,jpeg,tiff,bmp

# Chunking (Phase 3)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embeddings (Phase 3)
# Providers: fake | openai | gemini | huggingface
DEFAULT_EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSION=384
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector database (Phase 3)
# Backends: memory | qdrant | chroma | pinecone
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents
CHROMA_PERSIST_DIR=./chroma_db
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=default
SEARCH_TOP_K=5

# AI / LLM (Phase 4)
# Providers: fake | openai | gemini | claude
DEFAULT_LLM_PROVIDER=fake
OPENAI_LLM_MODEL=gpt-4o-mini
GEMINI_LLM_MODEL=gemini-2.5-flash
CLAUDE_LLM_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
RAG_TOP_K=5
RAG_HISTORY_TURNS=6
