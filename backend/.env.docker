# Used by docker-compose for the backend container
APP_NAME=Enterprise AI Knowledge Assistant
APP_VERSION=1.0.0
ENVIRONMENT=docker
DEBUG=false
API_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

SECRET_KEY=docker-dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

DEFAULT_EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSION=384
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_documents

DEFAULT_LLM_PROVIDER=fake
OPENAI_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
RAG_TOP_K=5
RAG_HISTORY_TURNS=6

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
